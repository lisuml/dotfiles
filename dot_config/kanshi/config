# ------------------------------------------------------------
# Output defaults
# ------------------------------------------------------------

# Lenovo external
output "Lenovo Group Limited L24q-10 U5V0Y19A" {
    mode 2560x1440@59.95Hz
    scale 1
    position 0,0
}

# Laptop internal
output eDP-1 {
    mode 1920x1200@60.00Hz
    scale 1
    position 0,0
}

# ------------------------------------------------------------
# Profiles
# ------------------------------------------------------------

# Undocked: ONLY internal
# IMPORTANT: do NOT mention Lenovo here (it may be unplugged)
profile laptop_undocked_internal_only {
    output eDP-1 enable position 0,0 scale 1
}

# Docked: ONLY Lenovo
profile laptop_docked_lenovo_only {
    output eDP-1 disable
    output "Lenovo Group Limited L24q-10 U5V0Y19A" enable
}

# Any machine with ONLY Lenovo (e.g. home PC)
profile lenovo_only {
    output "Lenovo Group Limited L24q-10 U5V0Y19A" enable
}
