{{- $kbdDev := (output "brightnessctl" "--list") | regexFind `'\S*kbd_backlight\S*'` | trimAll "'" -}}
# All lock paths go through ~/.local/bin/lock-screen, which locks the Bitwarden
# vault and then runs hyprlock. nwgbar's power menu calls the same script, so a
# lock started there is not dependent on hypridle running.
general {
    lock_cmd = $HOME/.local/bin/lock-screen
    before_sleep_cmd = $HOME/.local/bin/lock-screen
    after_sleep_cmd = hyprctl dispatch dpms on
}

listener {
    timeout = 150
    on-timeout = brightnessctl -s set 10
    on-resume = brightnessctl -r
}
{{ if $kbdDev }}
listener {
    timeout = 150
    on-timeout = brightnessctl -sd {{ $kbdDev }} set 0
    on-resume = brightnessctl -rd {{ $kbdDev }}
}
{{ end }}
listener {
    timeout = 300
    on-timeout = $HOME/.local/bin/lock-screen
}

listener {
    timeout = 330
    on-timeout = hyprctl dispatch dpms off
    on-resume = hyprctl dispatch dpms on
}

listener {
    timeout = 1800
    on-timeout = systemctl suspend
}
